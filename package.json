{
  "name": "content-automation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.34.5"
  },
  "pnpm": {
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    },
    "overrides": {
      "@babel/core@<7.29.6": "7.29.6",
      "@hono/node-server@<2.0.10": "2.0.10",
      "@modelcontextprotocol/sdk@>=1.10.0 <1.29.0": "1.29.0",
      "ajv@>=8.0.0 <8.20.0": "8.20.0",
      "body-parser@<1.20.6": "1.20.6",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "brace-expansion": "5.0.8",
      "esbuild@<0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <4.0.0": "3.1.4",
      "hono@<4.12.32": "4.12.32",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "linkify-it@<5.0.2": "5.0.2",
      "markdown-it@>=14.0.0 <14.3.0": "14.3.0",
      "minimatch@<3.1.5": "3.1.5",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "path-to-regexp@<0.1.13": "0.1.13",
      "path-to-regexp@>=8.0.0 <8.4.2": "8.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.5": "4.0.5",
      "postcss@<8.5.23": "8.5.23",
      "qs@>=6.7.0 <6.15.3": "6.15.3",
      "sharp@<0.35.3": "0.35.3",
      "uuid@>=11.0.0 <11.1.1": "11.1.1",
      "zod@>=4.0.0": "4.3.5"
    }
  },
  "workspaces": [
    "apps/*",
    "extension-react",
    "products/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:content",
    "dev:content": "set -a; . ./.env; set +a; BETTER_AUTH_URL=http://localhost:3005 FALKORDB_URL=${FALKORDB_URL:-redis://localhost:6380} FALKORDB_GRAPH=${FALKORDB_GRAPH:-content} POSTGRES_HOST=localhost turbo dev --filter=@content-automation/content-generator-app",
    "dev:outreach": "set -a; . ./.env; set +a; BETTER_AUTH_URL=http://localhost:3004 FALKORDB_URL=${FALKORDB_URL:-redis://localhost:6380} FALKORDB_GRAPH=${FALKORDB_GRAPH:-content} POSTGRES_HOST=localhost turbo dev --filter=@content-automation/outreach-app",
    "dev:docs": "pnpm --filter @content-automation/docs-app dev",
    "dev:styleguide": "turbo dev --filter=@content-automation/styleguide-app",
    "db:adopt": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/database db:adopt",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/database db:migrate",
    "auth:migrate": "pnpm db:migrate",
    "auth:seed": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/auth db:seed",
    "chat:migrate": "pnpm db:migrate",
    "chat:prune": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/chat retention:prune",
    "chat:preview-retention": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/chat retention:preview",
    "cascade:migrate": "pnpm db:migrate",
    "cascade:seed": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/cascade seed:demo",
    "cascade:worker": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/cascade worker",
    "content:migrate": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/content-generator db:migrate",
    "publishing:worker": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/content-generator publishing:worker",
    "build": "turbo build",
    "build:content": "turbo build --filter=@content-automation/content-generator-app",
    "build:outreach": "turbo build --filter=@content-automation/outreach-app",
    "build:docs": "NODE_OPTIONS=--max-old-space-size=1024 pnpm --filter @content-automation/docs-app build",
    "prune:outreach": "turbo prune @content-automation/outreach-app --docker --out-dir=out/pruned/outreach",
    "prune:content": "turbo prune @content-automation/content-generator-app --docker --out-dir=out/pruned/content-generator",
    "start:outreach": "npm run start --workspace=@content-automation/outreach-app",
    "start:content": "npm run start --workspace=@content-automation/content-generator-app",
    "start:docs": "pnpm --filter @content-automation/docs-app start",
    "lint": "turbo lint",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=3072 turbo typecheck --concurrency=1",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:auth": "pnpm --filter @content-automation/auth test",
    "test:observability": "pnpm --filter @content-automation/observability test",
    "test:platform": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost LANGFUSE_PUBLIC_KEY= LANGFUSE_SECRET_KEY= pnpm --filter @content-automation/platform test",
    "test:ui": "pnpm --filter @content-automation/ui test",
    "test:chat": "pnpm --filter @content-automation/chat test",
    "test:cascade": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost pnpm --filter @content-automation/cascade test",
    "test:content": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost FALKORDB_URL=${FALKORDB_URL:-redis://localhost:6380} FALKORDB_GRAPH=content_test LANGFUSE_PUBLIC_KEY= LANGFUSE_SECRET_KEY= pnpm --filter @content-automation/content-generator test",
    "test:outreach": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost FALKORDB_URL=${FALKORDB_URL:-redis://localhost:6380} FALKORDB_GRAPH=outreach_test LANGFUSE_PUBLIC_KEY= LANGFUSE_SECRET_KEY= pnpm --filter @content-automation/outreach test",
    "test:atlas": "set -a; . ./.env; set +a; POSTGRES_HOST=localhost FALKORDB_URL=${FALKORDB_URL:-redis://localhost:6380} FALKORDB_GRAPH=atlas_test pnpm --filter @content-automation/atlas test",
    "test": "pnpm run test:architecture && pnpm run test:observability && pnpm run test:auth && pnpm run test:platform && pnpm run test:ui && pnpm run test:chat && pnpm run test:cascade && pnpm run test:content && pnpm run test:outreach && pnpm run test:atlas"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.41",
    "@ai-sdk/rsc": "^2.0.39",
    "@assistant-ui/react": "0.11.54",
    "@assistant-ui/react-ai-sdk": "1.2.0",
    "@assistant-ui/react-markdown": "0.11.9",
    "@better-auth/drizzle-adapter": "1.6.24",
    "@mastra/ai-sdk": "1.0.2",
    "@mastra/core": "1.0.4",
    "@mastra/langfuse": "1.0.0",
    "@mastra/memory": "1.0.0",
    "@mastra/observability": "1.0.0",
    "@mastra/pg": "1.0.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/extension-placeholder": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "ai": "6.0.39",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.2",
    "falkordb": "^6.6.2",
    "lucide-react": "^0.554.0",
    "motion": "^12.29.0",
    "next": "16.3.0-preview.7",
    "pg": "^8.16.3",
    "react": "19.2.7",
    "react-day-picker": "^9.11.2",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "13.0.1",
    "zod": "4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "concurrently": "^10.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0-preview.7",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "turbo": "^2.5.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "license": "AGPL-3.0-only"
}
