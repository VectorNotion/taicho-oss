    "DD_VERSION",
    "LANGFUSE_BASE_URL",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_REALTIME",
    "LANGFUSE_SECRET_KEY",
    "MODEL_NAME",
    "OUTREACH_RESEARCH_MODEL",
    "NEXT_PUBLIC_AUTH_PROVIDERS",
