    "PUBLISHING_DATABASE_ROLE",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    "RAZORPAY_SUBSCRIPTION_TOTAL_COUNT",
    "PAYMENT_SESSION_TTL_MINUTES",
    "PAYLOAD_BILLING_CATALOG_URL",
    "PAYLOAD_BILLING_API_KEY",
    "PAYLOAD_BILLING_TENANT",
    "RELAY_R2_ACCESS_KEY_ID",
    "RELAY_R2_BUCKET",
    "RELAY_R2_ENDPOINT",
    "RELAY_R2_PUBLIC_URL",
    "RELAY_R2_SECRET_ACCESS_KEY",
    "PUBLIC_APP_URL",
    "TAVILY_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    }
  }
}
