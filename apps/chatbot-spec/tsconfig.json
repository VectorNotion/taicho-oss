{
  "extends": "../../packages/config/typescript/next.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/components/ui/*": ["./packages/ui/components/ui/*"],
      "@/lib/utils": ["./packages/ui/lib/utils.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
