# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage/
/test-results/
/playwright-report/

# next.js
/.next/
**/.next/
/out/

# turborepo
.turbo/
**/.turbo/

# production
/build
**/dist/

# Rust and Python local build environments
**/target/
**/.venv/
**/.pytest_cache/
**/__pycache__/
*.pyc

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NebulaGraph data and logs
/data/
/logs/
/studio-data/
# Local generated reports
artifacts/
!apps/unified/app/api/intelligence/v1/artifacts/
!apps/unified/app/api/intelligence/v1/artifacts/**
.firecrawl/
