# ── Required to boot ─────────────────────────────────────────────────────────
TZ=UTC

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3005
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3004,http://localhost:3005
AUTH_SIGNUP_POLICY=open
AUTH_SEED_PASSWORD=ContentAutomation123!
# Server-side JSON array of extra OAuth/OIDC providers; [] disables SSO buttons.
AUTH_OAUTH_PROVIDERS=[]
NEXT_PUBLIC_AUTH_PROVIDERS=[]

# PostgreSQL (auth, jobs, publishing, cascade schemas) — matches docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langgraph

# Graph backend (knowledge graph; see docs/graph-backend.md)
FALKORDB_URL=redis://localhost:6380
FALKORDB_GRAPH=content

# Explicit organization contexts for non-request workers/migrations.
CASCADE_ORGANIZATION_ID=replace-with-worker-organization-id
PUBLISHING_ORGANIZATION_ID=replace-with-worker-organization-id
CONTENT_MIGRATION_ORGANIZATION_ID=replace-with-migration-organization-id

# ── AI providers ─────────────────────────────────────────────────────────────
# Agents resolve their model through OpenRouter (default qwen/qwen3.7-plus).
OPENROUTER_API_KEY=your_openrouter_api_key_here
# MODEL_NAME=qwen/qwen3.7-plus
# OpenAI — embeddings only (topic extraction)
OPENAI_API_KEY=your_openai_api_key_here
# Tavily powers research (trend discovery, lead intelligence)
TAVILY_API_KEY=your_tavily_api_key_here
# AssemblyAI — video transcription
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ── Optional integrations ────────────────────────────────────────────────────
# Creative media generation (FAL queue + webhook APIs)
FAL_KEY=
# CREATIVE_MEDIA_WEBHOOK_URL=https://public.example.com/api/content/media/fal/webhook

# Cloudflare R2 media staging (publishing binary handoffs)
RELAY_R2_ENDPOINT=
RELAY_R2_ACCESS_KEY_ID=
RELAY_R2_SECRET_ACCESS_KEY=
RELAY_R2_BUCKET=
RELAY_R2_PUBLIC_URL=

# Publishing platform credentials — each destination needs its pair.
LAUNCH_PUBLISHING_DESTINATIONS=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Google Calendar (scheduling control panel)
GOOGLE_CALENDAR_API_KEY=

# Nurture (cascade) email delivery. Generate keys with: openssl rand -base64 32
CASCADE_PUBLIC_URL=http://localhost:3000
CASCADE_SECRET=replace-with-at-least-32-random-characters
CASCADE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
CASCADE_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# ── Observability (all optional; defaults to structured logs only) ───────────
OBSERVABILITY_ENABLED=false
OBSERVABILITY_LOG_LEVEL=info
# Langfuse Cloud (AI traces). Prompts/completions are always redacted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
